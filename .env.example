# ---------------------------------------------------------------------------
# GuidedReel — environment variables
# Copy to .env (root) or apps/web/.env.local. Never commit real values.
# ---------------------------------------------------------------------------

# ---- Web app (apps/web) ----------------------------------------------------
# Public base URL of the web app (used for absolute links in emails/redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (web persistence + storage). Leave empty to run in local-first mode
# (projects and assets stay in the browser's IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side render worker (apps/web/src/server/render)
# Directory where render jobs write temp assets and output MP4s.
RENDER_WORK_DIR=.render
# Max concurrent renders handled by the in-process worker.
RENDER_CONCURRENCY=1
# Max upload size per asset in bytes (default 500MB).
MAX_ASSET_SIZE_BYTES=524288000

# ---- Desktop app (apps/desktop) ---------------------------------------------
# Code signing (CI only; not required for local development)
CSC_LINK=
CSC_KEY_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# ---- Text-to-speech ---------------------------------------------------------
# No server-side keys: users enter their own OpenAI / ElevenLabs / Google keys in
# Settings; the web API forwards them per request and never stores them.

# ---- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
