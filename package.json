{
  "name": "guidedreel",
  "version": "0.1.0",
  "description": "Script-to-video creator for Reels, Shorts, TikTok and ads. Shared Remotion engine behind a Next.js web app and an Electron desktop app.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Padma Raj Lama",
    "url": "https://github.com/prlama55"
  },
  "homepage": "https://github.com/prlama55/GuidedReel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prlama55/GuidedReel.git"
  },
  "bugs": {
    "url": "https://github.com/prlama55/GuidedReel/issues"
  },
  "keywords": [
    "video-editor",
    "video-generator",
    "remotion",
    "nextjs",
    "electron",
    "react",
    "typescript",
    "short-video",
    "instagram-reels",
    "youtube-shorts",
    "tiktok",
    "text-to-speech",
    "monorepo"
  ],
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@guidedreel/web...",
    "dev:desktop": "turbo run dev --filter=@guidedreel/desktop...",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@guidedreel/web...",
    "build:desktop": "turbo run build --filter=@guidedreel/desktop...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@guidedreel/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "build:packages": "turbo run build --filter='./packages/*'",
    "test:integration": "turbo run test:integration",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@guidedreel/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
