{
  "name": "@guidedreel/storage",
  "version": "0.2.0",
  "description": "Project and asset storage interfaces with IndexedDB, memory and filesystem implementations for GuidedReel.",
  "license": "MIT",
  "author": {
    "name": "Padma Raj Lama",
    "url": "https://github.com/prlama55"
  },
  "homepage": "https://github.com/prlama55/GuidedReel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prlama55/GuidedReel.git",
    "directory": "packages/storage"
  },
  "bugs": {
    "url": "https://github.com/prlama55/GuidedReel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@guidedreel/engine": "workspace:*",
    "@guidedreel/schema": "workspace:*",
    "idb": "catalog:"
  },
  "devDependencies": {
    "@guidedreel/config": "workspace:*",
    "eslint": "catalog:",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
