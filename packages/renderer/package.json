{
  "name": "@guidedreel/renderer",
  "version": "0.2.0",
  "description": "VideoRenderer interface and local Remotion renderer for GuidedReel (Node).",
  "license": "MIT",
  "author": {
    "name": "Padma Raj Lama",
    "url": "https://github.com/prlama55"
  },
  "homepage": "https://github.com/prlama55/GuidedReel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prlama55/GuidedReel.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/prlama55/GuidedReel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "examples": "tsx scripts/render-examples.ts",
    "clean": "rimraf dist .turbo coverage .remotion-bundle"
  },
  "dependencies": {
    "@guidedreel/compositions": "workspace:*",
    "@guidedreel/engine": "workspace:*",
    "@guidedreel/schema": "workspace:*",
    "@remotion/bundler": "catalog:",
    "@remotion/renderer": "catalog:"
  },
  "devDependencies": {
    "@guidedreel/config": "workspace:*",
    "@guidedreel/templates": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
