{
  "name": "@guidedreel/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "examples": "tsx scripts/render-examples.ts",
    "clean": "rimraf dist .turbo coverage .remotion-bundle"
  },
  "dependencies": {
    "@remotion/bundler": "catalog:",
    "@remotion/renderer": "catalog:",
    "@guidedreel/compositions": "workspace:*",
    "@guidedreel/engine": "workspace:*",
    "@guidedreel/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@guidedreel/config": "workspace:*",
    "@guidedreel/templates": "workspace:*",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
