{
  "name": "@guidedreel/ui",
  "version": "0.2.0",
  "description": "Shared React editor components and store for GuidedReel.",
  "license": "MIT",
  "author": {
    "name": "Padma Raj Lama",
    "url": "https://github.com/prlama55"
  },
  "homepage": "https://github.com/prlama55/GuidedReel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prlama55/GuidedReel.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/prlama55/GuidedReel/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@guidedreel/compositions": "workspace:*",
    "@guidedreel/engine": "workspace:*",
    "@guidedreel/providers": "workspace:*",
    "@guidedreel/schema": "workspace:*",
    "@guidedreel/storage": "workspace:*",
    "@guidedreel/templates": "workspace:*",
    "@remotion/player": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react-resizable-panels": "catalog:",
    "remotion": "catalog:",
    "zundo": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@guidedreel/config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
